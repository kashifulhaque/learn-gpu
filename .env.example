# ---------------------------------------------------------------------------
# learn-gpu — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Single sign-on ---------------------------------------------------------
# Required shared secret for the trusted Caddy reverse proxy. Caddy sends this
# in X-SSO-Proxy with Remote-User after Authelia authenticates each request.
SSO_PROXY_SECRET=
# Maps an Authelia username to the name that holds that reader's progress, for
# example "alice:alice,bob:robert". Unmapped users keep their own name.
SSO_USERS=

# --- App --------------------------------------------------------------------
# Directory for the SQLite database. Mounted as a volume in docker-compose.
DATA_DIR=/data
# Public base URL, used only for display.
PUBLIC_URL=https://gpu.ifkash.dev

# --- GPU providers ----------------------------------------------------------
# The provider labs run on. RunPod is the only one.
GPU_PROVIDER=runpod
# The accelerator the labs ask for, shown in the header. The labs target the
# A100 80GB (Ampere, sm_80).
GPU_TYPE=A100-80GB

# RunPod (https://runpod.io).
RUNPOD_API_KEY=
# Serverless endpoint id running the worker in gpu/runpod_worker/.
RUNPOD_ENDPOINT_ID=
