# ---------------------------------------------------------------------------
# learn-gpu — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Auth -------------------------------------------------------------------
# Shared password for the people who use this app.
APP_PASSWORD=change-me
# Random string used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
# How long a login lasts, in days.
SESSION_DAYS=30
# Set to 1 when serving over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=1

# --- App --------------------------------------------------------------------
# Directory for the SQLite database. Mounted as a volume in docker-compose.
DATA_DIR=/data
# Public base URL, used only for display.
PUBLIC_URL=https://gpu.ifkash.dev

# --- GPU providers ----------------------------------------------------------
# The provider labs run on. RunPod is the only one.
GPU_PROVIDER=runpod
# The accelerator the labs ask for, shown in the header. The labs target the
# A100 80GB (Ampere, sm_80).
GPU_TYPE=A100-80GB

# RunPod (https://runpod.io).
RUNPOD_API_KEY=
# Serverless endpoint id running the worker in gpu/runpod_worker/.
RUNPOD_ENDPOINT_ID=
